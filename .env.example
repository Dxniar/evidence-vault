# Copy to .env and fill on the server. Never commit real values.
EVIDENCE_VAULT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Dashboard → Connect → Session pooler (port 5432), or direct if IPv6 is available.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.project-ref:password@your-pooler-host:5432/postgres
SUPABASE_URL=https://project-ref.supabase.co
# Dashboard → Settings → API Keys → Secret keys. Keep only on the server.
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-server-key
SUPABASE_STORAGE_BUCKET=evidence-private
APP_ALLOWED_HOSTS=vault.example.com
# Set to 1 only if exactly one trusted reverse proxy forwards requests.
TRUST_PROXY_COUNT=1
# Display and datetime-local acquisition input offset. Stored timestamps remain UTC.
DISPLAY_TIMEZONE_OFFSET_HOURS=5
APP_LOG_LEVEL=INFO
# Optional: create a Google Cloud OAuth client of type "Web application".
# Authorized redirect URI for local testing: http://localhost:8080/auth/google/callback
# Both values are required to enable Google sign-in. Keep the secret server-side.
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
